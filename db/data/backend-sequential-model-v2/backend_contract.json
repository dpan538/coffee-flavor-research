{
  "$defs": {
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "type": "string"
        },
        "question_id": {
          "type": "string"
        },
        "selected_option_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "type": "array",
          "uniqueItems": true
        },
        "shown_option_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "slot": {
          "enum": [
            "Q0",
            "Q1",
            "Q2",
            "Q3",
            "Q4",
            "Q5"
          ]
        },
        "state": {
          "enum": [
            "NONE_OF_THESE",
            "SELECTED",
            "SKIP",
            "UNSURE"
          ]
        }
      },
      "required": [
        "slot",
        "question_id",
        "axis",
        "shown_option_ids",
        "selected_option_ids",
        "state"
      ],
      "type": "object"
    },
    "Context": {
      "additionalProperties": false,
      "properties": {
        "c0": {
          "enum": [
            "preparation.family.filter_percolation",
            "preparation.family.immersion",
            "preparation.family.hybrid",
            "preparation.family.espresso_pressure",
            "preparation.family.diluted_espresso",
            "preparation.family.stovetop_boiled",
            "preparation.family.cold_extraction",
            "preparation.family.espresso_milk"
          ]
        },
        "c1": {
          "enum": [
            "extremely_light",
            "light",
            "medium_light",
            "medium",
            "medium_dark",
            "dark",
            "extremely_dark"
          ]
        }
      },
      "required": [
        "c0",
        "c1"
      ],
      "type": "object"
    },
    "FinalComparison": {
      "additionalProperties": false,
      "properties": {
        "exposed_candidates": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 3,
          "type": "array",
          "uniqueItems": true
        },
        "feedback_source": {
          "enum": [
            "REAL_HUMAN",
            "SIMULATED"
          ]
        },
        "generation_version": {
          "type": "string"
        },
        "selected_candidates": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "exposed_candidates",
        "selected_candidates",
        "feedback_source",
        "generation_version"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answers": {
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/Answer"
          },
          {
            "items": {
              "$ref": "#/$defs/Answer"
