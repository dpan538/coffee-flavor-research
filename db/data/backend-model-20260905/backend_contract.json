    "argv": [
      "python",
      "db/scripts/flavor_backend.py",
      "--model-file",
      "$COFFEE_BACKEND_MODEL_ROOT/models/M1_BALANCED.model.json"
    ],
    "exit_codes": {
      "0": "computed result",
      "2": "input validation error"
    },
    "input_has_no_case_id": true,
    "stdin": "A JSON Request; use example_request or a new valid catalog answer sequence"
  },
  "components": {
    "build_candidate_state": {
