{
  "$defs": {
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "type": "string"
        },
        "selected_option_ids": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "shown_option_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "state": {
          "enum": [
            "NONE_OF_THESE",
            "SELECTED",
            "SKIP",
            "UNSURE"
          ]
        }
      },
      "required": [
        "question_id",
        "shown_option_ids",
        "selected_option_ids",
        "state"
      ],
      "type": "object"
    },
    "AnswerUpdate": {
      "additionalProperties": false,
      "properties": {
        "base_component": {
          "type": "number"
        },
        "candidate_id": {
          "type": "string"
        },
        "context_component": {
          "type": "number"
        },
        "direct_answer_component": {
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "interaction_component": {
          "type": "number"
        },
        "question_id": {
          "type": "string"
        },
        "rank_after": {
          "minimum": 0,
          "type": "integer"
        },
        "rank_before": {
          "minimum": 0,
          "type": "integer"
        },
        "score_after": {
          "type": "number"
        },
        "score_before": {
          "type": "number"
        },
        "selected_option_ids": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "semantic_component": {
          "type": "number"
        },
        "shown_option_ids": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "update_reason": {
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "shown_option_ids",
        "selected_option_ids",
        "candidate_id",
        "score_before",
        "base_component",
        "context_component",
        "direct_answer_component",
        "semantic_component",
        "interaction_component",
        "score_after",
        "rank_before",
        "rank_after",
        "evidence_ids",
        "update_reason"
      ],
      "type": "object"
    },
    "CandidateScore": {
      "additionalProperties": false,
      "properties": {
        "base_component": {
          "type": "number"
        },
        "candidate_id": {
          "type": "string"
        },
        "context_component": {
          "type": "number"
        },
        "direct_answer_component": {
          "type": "number"
        },
        "directly_expressed": {
          "type": "boolean"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "interaction_component": {
          "type": "number"
        },
        "rank": {
          "minimum": 1,
          "type": "integer"
        },
        "score": {
          "type": "number"
        },
        "semantic_component": {
          "type": "number"
        }
      },
      "required": [
        "candidate_id",
        "base_component",
        "context_component",
        "direct_answer_component",
        "semantic_component",
        "interaction_component",
        "score",
