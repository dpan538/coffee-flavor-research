        "dataset_manifest.json admitted artifact(s)",
        "TRAIN coffee groups only for learned statistics",
        "project-authored question routing; directions are exploratory support, not child confirmation"
      ],
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "bundle": {
