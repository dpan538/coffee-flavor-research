              "B1",
              "B2",
              "M1"
            ]
          }
        },
        "required": [
          "context",
          "bundle",
          "model"
        ],
        "type": "object"
      },
      "module": "db/scripts/flavor_backend.py",
      "output_schema": {
        "$ref": "#/$defs/CandidateState"
      },
      "runtime_dependencies": [
        "Python >=3.12 standard library",
        "locally retained bundle; no network, database, frontend or case table"
