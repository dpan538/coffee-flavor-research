            "preparation.family.hybrid",
            "preparation.family.espresso_pressure",
            "preparation.family.diluted_espresso",
            "preparation.family.stovetop_boiled",
            "preparation.family.cold_extraction",
            "preparation.family.espresso_milk"
          ]
        },
        "c1": {
          "enum": [
            "extremely_light",
            "light",
            "medium_light",
            "medium",
            "medium_dark",
            "dark",
            "extremely_dark"
          ]
        }
      },
      "required": [
        "c0",
        "c1"
      ],
      "type": "object"
    },
    "FinalResult": {
