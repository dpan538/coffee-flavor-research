  "semantics": {
    "context": "C0/C1 mandatory enums. Learned context effects masked in live API until a documented source-to-product mapping exists. Missing source context stays missing internally. Frozen proxy source-roast matches are nominal, not seven-level production labels.",
    "multi_select": "Unique selected IDs subset of shown IDs; all selected are legitimate; no inferred exclusivity. Per-question direct evidence budget 3.0; displayed unselected options neutral unless explicit NONE_OF_THESE.",
    "question_selection": "TRAIN-only empirical information gain, >=2 response patterns each supported by >=2 coffee groups, nonzero gain and materially different possible top-5 rankings; <=5 questions. Record proxy, not validated real answers.",
    "result": "Unique main<=5 and secondary<=3, no display-policy fields. A candidate rank is not confidence or a confirmed identification.",
    "retry": "Canonical identical answer is idempotent including trace. Correction replaces the question answer and recomputes effects from active answers.",
    "score_trace": "Components describe the complete active state after the update. score_after=sum(components); delta=score_after-score_before. Source evidence IDs describe TRAIN provenance, not judge support for the requested coffee.",
    "training": "RECORD_RECOVERY_PROXY only. Frozen core runtime is in owner/core-freeze and commit d2e1676; present live semantic guard fixes do not retroactively change core metrics."
  }
}
