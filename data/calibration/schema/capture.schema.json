{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-flavor-atlas.example/schema/calibration-capture-v0.1.0.json",
  "title": "Coffee Sensory Context Calibration capture envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_status",
    "study_key",
    "protocol_version_key",
    "record_origin_code",
    "records"
  ],
  "properties": {
    "artifact_status": {
      "const": "PROTOCOL_AND_SCHEMA_ONLY"
    },
    "study_key": {
      "const": "study.context_calibration_v0.minimum"
    },
    "protocol_version_key": {
      "const": "protocol.context_calibration_v0.2026_08_25"
    },
    "record_origin_code": {
      "enum": ["real_observation", "DRY_RUN_FIXTURE", "TEST_FIXTURE"]
    },
    "records": {
      "type": "array",
      "maxItems": 0
    }
  }
}
